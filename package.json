{
  "name": "lastdayllm",
  "version": "0.1.0",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:trigger": "npx trigger.dev@4.4.0 dev",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:trigger\" -n \"NEXT,TRIGGER\" -c \"cyan,magenta\"",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "check:outdated": "npm outdated",
    "update:safe": "npx npm-check-updates -u --target patch && npm install",
    "prebuild": "npm run type-check",
    "test:gemini": "npx tsx scripts/test-gemini-model.ts"
  },
  "dependencies": {
    "@google/genai": "^1.40.0",
    "@qdrant/js-client-rest": "^1.16.2",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.47.10",
    "@trigger.dev/core": "4.4.0",
    "@trigger.dev/sdk": "4.4.0",
    "@types/pdf-parse": "^1.1.5",
    "file-type": "^21.2.0",
    "jszip": "^3.10.1",
    "next": "^15.1.3",
    "officeparser": "^6.0.4",
    "openai": "^6.37.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@trigger.dev/build": "4.4.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.6",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.23",
    "concurrently": "^9.1.2",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.7.2"
  }
}
